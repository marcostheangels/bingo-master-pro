# ============================================
# OBRIGATORIOS - Configurar no Render
# ============================================

# URL de conexao do Neon (PostgreSQL)
# Criar em: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Chave de API do Asaas (PIX)
# Obter em: https://www.asaas.com
ASAAS_API_KEY=$asaas_api_key_aqui

# ============================================
# OPCIONAIS
# ============================================

# Ambiente Asaas: production ou sandbox
ASAAS_ENV=production

# Porta do servidor (Render define automaticamente via PORT)
PORT=3000
