# ============================================
# MERCADO PAGO - CONFIGURACAO
# ============================================
# 1. Acesse https://www.mercadopago.com.br/developers/panel
# 2. Crie uma aplicacao ou use uma existente
# 3. Va em "Credenciais" e copie o "Access Token" (producao)
# 4. Cole abaixo (sem aspas)
MERCADO_PAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# 5. Va em "Webhooks" e cadastre: https://seudominio.com/api/webhook
#    (se for local, use ngrok: https://ngrok.com)
#    Deixe marcado apenas "PIX" como evento

# ============================================
# SERVIOCO (opicional - padrao: 3000)
# ============================================
PORT=3000
